---
import { env } from 'cloudflare:workers';
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ButtonLink from '../components/ButtonLink.astro';
import PillTag from '../components/PillTag.astro';
import FlagshipCaseStudyCard from '../components/FlagshipCaseStudyCard.astro';
import ArchitectureReasoning from '../components/ArchitectureReasoning.astro';
import {
  createGitBookPortfolioFromEnv,
  presentProjectTag,
} from '../lib/gitbook';
import type { GitBookRuntimeEnv, PortfolioProjectSummary } from '../lib/gitbook';

export const prerender = false;

const gitbookEnv = env as unknown as GitBookRuntimeEnv;
let featured: PortfolioProjectSummary[] = [];

if (gitbookEnv.GITBOOK_TOKEN?.trim()) {
  try {
    const portfolio = createGitBookPortfolioFromEnv(gitbookEnv);
    featured = await portfolio.getShowcaseProjects(2);
  } catch (error) {
    console.error('GitBook showcase discovery failed on the homepage.', error);
  }
}

const identityChips = [
  'Solution Architecture',
  'Integration Architecture',
  'Cloud & Edge',
  'Information & Data',
];

const architectureLenses = [
  { label: 'Business', value: 'Problem, stakeholders, outcomes and operational impact' },
  { label: 'Application', value: 'Responsibilities, boundaries, interfaces and integration contracts' },
  { label: 'Information', value: 'Ownership, movement, transformation and retrieval' },
  { label: 'Technology', value: 'Runtime, trust boundaries, resilience and operability' },
];

const architectureDomains = [
  {
    title: 'Solution & Integration Architecture',
    copy: 'Defining system boundaries, responsibilities, APIs, contracts and dependency patterns so services can evolve without accidental coupling.',
  },
  {
    title: 'Cloud & Platform Architecture',
    copy: 'Shaping edge, runtime and deployment responsibilities around resilience, security, observability and operational control.',
  },
  {
    title: 'Information & Search Architecture',
    copy: 'Designing information models, indexing boundaries, ownership and retrieval patterns that keep discovery separate from systems of record.',
  },
  {
    title: 'Automation & AI-enabled Systems',
    copy: 'Structuring orchestration, workflow and data-processing capabilities around explicit hand-offs, controls and maintainable operating models.',
  },
];

const architectureArtefacts = [
  'System context views',
  'Current / target state',
  'Integration flows',
  'Information flows',
  'Architecture decisions',
  'Non-functional requirements',
  'Transition approaches',
  'POCs & validation evidence',
];

const supportingPlatforms = [
  'Cloudflare',
  'Webflow',
  'Meilisearch',
  'APIs',
  'Docker',
  'SQL & data services',
  'TypeScript',
  'AI-assisted engineering',
];

const flagshipAccents = ['primary', 'secondary', 'tertiary'] as const;
---

<MainLayout
  title="Taj | Solution & Integration Architect"
  description="Solution and Integration Architect focused on system boundaries, integration patterns, cloud platforms and evidence-led architecture decisions."
  width="full"
>
  <Container size="wide">
    <section class="hero-shell">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker hero__stagger hero__stagger--1">Tajinder Singh · Solution &amp; Integration Architect</p>
          <h1 class="hero__stagger hero__stagger--2">Turning complex system problems into clear, traceable architecture.</h1>
          <p class="hero-positioning hero__stagger hero__stagger--3">
            I design solution and integration architectures that connect business needs to system boundaries,
            information flows, technology choices, transition paths and operational controls.
          </p>
          <p class="hero-support hero__stagger hero__stagger--4">
            The work on this site shows the reasoning behind the design: current state, constraints, options,
            decisions, target architecture and validation — not just the finished technology.
          </p>
          <div class="hero-actions hero__stagger hero__stagger--5">
            <ButtonLink href="/work">Explore Architecture Work</ButtonLink>
            <ButtonLink href="/about" variant="secondary">How I Work</ButtonLink>
          </div>
          <div class="hero-proof hero__stagger hero__stagger--6">
            {identityChips.map((item) => <PillTag label={item} />)}
          </div>
        </div>

        <aside class="architecture-board hero__stagger hero__stagger--4" aria-label="Architecture viewpoints">
          <div class="architecture-board__identity">
            <img
              src="/images/tajinder-singh-portrait.jpg"
              alt="Portrait of Tajinder Singh"
              loading="eager"
              width="96"
              height="96"
            />
            <div>
              <span>Architecture lens</span>
              <strong>Problem → decision → target state → evidence</strong>
            </div>
          </div>

          <div class="architecture-board__layers">
            {architectureLenses.map((item, index) => (
              <article>
                <span class="architecture-board__index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{item.label}</strong>
                  <p>{item.value}</p>
                </div>
              </article>
            ))}
          </div>

          <div class="architecture-board__footer">
            <span>Cross-cutting</span>
            <strong>Security · resilience · operability · transition · governance</strong>
          </div>
        </aside>
      </div>
    </section>

    <section class="section reasoning-section">
      <ArchitectureReasoning />
    </section>

    <section class="featured-work section">
      <div data-reveal="soft">
        <SectionHeading
          eyebrow="Architecture Evidence"
          title="Selected case studies"
          description="Each case study is structured as an architecture dossier: problem context, current state, options, target architecture, decisions, cross-cutting concerns, transition and validation."
        />
      </div>
      {featured.length ? (
        <ul class="flagship-grid">
          {featured.map((item, index) => (
            <li class:list={['flagship-grid__item', { 'flagship-grid__item--lead': index === 0 }]} data-reveal="soft">
              <FlagshipCaseStudyCard
                title={item.title}
                summary={item.description}
                tags={item.tags.map(presentProjectTag)}
                sectionCount={item.sectionCount}
                href={`/work/${item.slug}/`}
                index={index + 1}
                accent={flagshipAccents[index] ?? 'primary'}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="section-intro">Architecture case studies are temporarily unavailable.</p>
      )}
      <div class="section-action">
        <ButtonLink href="/work" variant="secondary">View All Case Studies</ButtonLink>
      </div>
    </section>

    <section class="section">
      <div data-reveal="soft">
        <SectionHeading
          eyebrow="Architecture Domains"
          title="The responsibilities I work across"
          description="The focus is the placement of responsibilities and the quality of system decisions. Products and frameworks support that work rather than define it."
        />
      </div>
      <div class="domain-grid">
        {architectureDomains.map((item, index) => (
          <article class="domain-row" data-reveal="soft">
            <span class="domain-row__index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section practice-grid">
      <article class="practice-panel surface-card surface-card--feature" data-reveal="soft">
        <SectionHeading
          eyebrow="Architecture Practice"
          title="Artefacts that make decisions visible"
          description="I use the minimum useful set of views and records needed to make system reasoning understandable to stakeholders and delivery teams."
        />
        <div class="artefact-list">
          {architectureArtefacts.map((item) => <span>{item}</span>)}
        </div>
      </article>

      <article class="practice-panel surface-card surface-card--soft" data-reveal="soft">
        <SectionHeading
          eyebrow="Supporting Technology"
          title="Platforms are implementation choices, not the portfolio identity"
          description="I work hands-on enough to validate architecture, prototype integration paths and understand operational constraints."
        />
        <div class="platform-list">
          {supportingPlatforms.map((item) => <PillTag label={item} />)}
        </div>
      </article>
    </section>

    <section class="section contact-cta surface-card surface-card--feature" data-reveal="soft">
      <div>
        <p class="contact-cta__eyebrow">Contact</p>
        <h2>Architecture roles, collaboration, or a system problem worth discussing?</h2>
        <p>
          I am interested in work where solution boundaries, integrations, information movement or platform
          responsibilities need to become clearer and more supportable.
        </p>
      </div>
      <div class="contact-cta__actions">
        <ButtonLink href="/contact">Get in Touch</ButtonLink>
        <ButtonLink href="/about" variant="secondary">About My Approach</ButtonLink>
      </div>
    </section>
  </Container>
</MainLayout>

<style>
  .section {
    margin-top: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-shell {
    position: relative;
    padding: clamp(1rem, 2vw, 1.55rem);
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, var(--color-border));
    border-radius: calc(var(--radius-lg) + 0.25rem);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-bg-elevated) 96%, transparent), color-mix(in srgb, var(--color-bg-elevated) 90%, transparent)),
      radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 35%),
      radial-gradient(circle at 5% 100%, color-mix(in srgb, var(--color-focus) 10%, transparent), transparent 30%);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    gap: clamp(1.2rem, 3vw, 2.4rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    max-width: 39rem;
  }

  .hero-kicker,
  .contact-cta__eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-copy h1 {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(2rem, 1.4rem + 2vw, 3.45rem);
    line-height: 1.02;
  }

  .hero-positioning,
  .hero-support {
    margin: 0;
    max-width: 38rem;
  }

  .hero-positioning {
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.12rem);
    color: var(--color-text);
  }

  .hero-support {
    font-size: var(--font-size-ui);
  }

  .hero-actions,
  .hero-proof,
  .platform-list,
  .contact-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-actions {
    padding-top: var(--space-2);
  }

  .architecture-board {
    display: grid;
    gap: var(--space-3);
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-elevated) 82%, var(--color-surface));
    box-shadow: var(--shadow-sm);
  }

  .architecture-board__identity {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: center;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .architecture-board__identity img {
    width: 3.6rem;
    height: 3.6rem;
    object-fit: cover;
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }

  .architecture-board__identity span,
  .architecture-board__footer span {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .architecture-board__identity strong,
  .architecture-board__footer strong {
    font-size: 0.87rem;
    line-height: 1.4;
  }

  .architecture-board__layers {
    display: grid;
    gap: 0.5rem;
  }

  .architecture-board__layers article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    padding: 0.72rem 0.75rem;
    border-left: 2px solid color-mix(in srgb, var(--color-accent) 50%, var(--color-border));
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: color-mix(in srgb, var(--color-surface) 64%, transparent);
  }

  .architecture-board__index {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .architecture-board__layers strong {
    display: block;
    margin-bottom: 0.14rem;
    font-size: 0.86rem;
  }

  .architecture-board__layers p {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .architecture-board__footer {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .flagship-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .flagship-grid__item {
    height: 100%;
  }

  .section-action {
    margin-top: var(--space-4);
  }

  .domain-grid {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .domain-row {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .domain-row__index {
    padding-top: 0.15rem;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .domain-row h3 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.12rem, 1.03rem + 0.3vw, 1.35rem);
  }

  .domain-row p {
    margin: 0;
    max-width: 52rem;
    font-size: var(--font-size-ui);
  }

  .practice-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-4);
    align-items: start;
  }

  .practice-panel {
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .practice-panel :global(.section-heading) {
    margin-bottom: var(--space-4);
  }

  .artefact-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .artefact-list span {
    padding: 0.7rem 0.2rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-ui);
    color: var(--color-text);
  }

  .artefact-list span:nth-child(odd) {
    padding-right: var(--space-3);
  }

  .artefact-list span:nth-child(even) {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
  }

  .contact-cta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: end;
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
  }

  .contact-cta h2 {
    margin: 0.35rem 0 0.6rem;
    max-width: 20ch;
    font-size: clamp(1.55rem, 1.25rem + 1vw, 2.35rem);
  }

  .contact-cta p {
    margin: 0;
    max-width: 48rem;
  }

  .contact-cta__actions {
    flex: 0 0 auto;
  }

  .hero__stagger {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    animation: hero-rise 680ms var(--ease-emphasis) forwards;
  }

  .hero__stagger--1 { animation-delay: 60ms; }
  .hero__stagger--2 { animation-delay: 120ms; }
  .hero__stagger--3 { animation-delay: 180ms; }
  .hero__stagger--4 { animation-delay: 240ms; }
  .hero__stagger--5 { animation-delay: 300ms; }
  .hero__stagger--6 { animation-delay: 360ms; }

  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 980px) {
    .hero-grid,
    .practice-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      max-width: none;
    }

    .hero-copy h1 {
      max-width: 14ch;
    }

    .flagship-grid {
      grid-template-columns: 1fr;
    }

    .contact-cta {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 620px) {
    .section {
      margin-top: 2.5rem;
    }

    .hero-shell {
      padding: 0.9rem;
    }

    .hero-copy h1 {
      max-width: none;
      font-size: clamp(1.85rem, 1.5rem + 1.8vw, 2.3rem);
    }

    .architecture-board__identity {
      grid-template-columns: auto 1fr;
    }

    .domain-row {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      gap: var(--space-2);
    }

    .artefact-list {
      grid-template-columns: 1fr;
    }

    .artefact-list span:nth-child(even) {
      padding-left: 0.2rem;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stagger {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
