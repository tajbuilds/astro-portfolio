---
import { env } from 'cloudflare:workers';
import MainLayout from '../../layouts/MainLayout.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PillTag from '../../components/PillTag.astro';
import ProofStrip from '../../components/ProofStrip.astro';
import {
	createGitBookPortfolioFromEnv,
	formatProjectTagLabel,
	normalizeProjectTagKey,
} from '../../lib/gitbook';
import type { GitBookRuntimeEnv, PortfolioProjectSummary } from '../../lib/gitbook';
import { workOverviewProofItems } from '../../lib/proof-data';

export const prerender = false;

const gitbookEnv = env as unknown as GitBookRuntimeEnv;
let gitbookProjects: PortfolioProjectSummary[] = [];
let tags: string[] = [];
let gitbookError = false;

if (gitbookEnv.GITBOOK_TOKEN?.trim()) {
	try {
		const portfolio = createGitBookPortfolioFromEnv(gitbookEnv);
		[gitbookProjects, tags] = await Promise.all([
			portfolio.getProjects(),
			portfolio.getProjectTags(),
		]);
	} catch (error) {
		gitbookError = true;
		console.error('GitBook project discovery failed on /work.', error);
	}
} else {
	gitbookError = true;
}
---

<MainLayout
	title="Work | Tajinder Singh"
	description="Architecture case studies focused on edge security, automation, and data/search systems."
	width="full"
>
	<Container size="wide">
		<section class="work-intro">
			<div data-reveal="soft">
				<SectionHeading
					eyebrow="Portfolio"
					title="Case Studies"
					description="Selected architecture and platform work across verification pipelines, search systems, and high-leverage automation."
				/>
			</div>
		</section>

		<section class="work-filter surface-card surface-card--soft" aria-label="Filter by tag" data-reveal="soft">
			<p>Filter by focus area:</p>
			<div class="work-filter__tags">
				<PillTag label="All" href="/work/" />
				{tags.map((tag) => (
					<PillTag
						label={formatProjectTagLabel(tag)}
						href={`/work/tags/${normalizeProjectTagKey(tag)}/`}
					/>
				))}
			</div>
		</section>

		<ProofStrip
			eyebrow="Selected Outcomes"
			title="Common improvements across the case studies"
			items={workOverviewProofItems}
			compact={true}
		/>

		<section>
			{gitbookProjects.length > 0 ? (
				<ul class="work-grid">
					{gitbookProjects.map((project) => (
						<li data-reveal="soft">
							<ProjectCard
								title={project.title}
								description={project.description}
								tags={project.tags.map(formatProjectTagLabel)}
								href={`/work/${project.slug}/`}
							/>
						</li>
					))}
				</ul>
			) : (
				<p class="section-intro">
					{gitbookError
						? 'Case studies are temporarily unavailable.'
						: 'No case studies have been published yet.'}
				</p>
			)}
		</section>
	</Container>
</MainLayout>

<style>
	.work-intro {
		margin-bottom: var(--space-6);
	}

	.work-filter {
		display: grid;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
		padding: 0.95rem;
	}

	.work-filter p {
		margin: 0;
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.work-filter__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.work-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
	}

	.work-grid li {
		height: 100%;
	}

	@media (max-width: 900px) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
