---
import { env } from 'cloudflare:workers';

import MainLayout from '../../../layouts/MainLayout.astro';
import Container from '../../../components/Container.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import PillTag from '../../../components/PillTag.astro';
import {
	createGitBookPortfolioFromEnv,
	formatProjectTagLabel,
	normalizeProjectTagKey,
} from '../../../lib/gitbook';
import type {
	GitBookRuntimeEnv,
	PortfolioProjectSummary,
} from '../../../lib/gitbook';

export const prerender = false;

const gitbookEnv = env as unknown as GitBookRuntimeEnv;
const tagSlug = normalizeProjectTagKey(Astro.params.tag ?? '');

if (!gitbookEnv.GITBOOK_TOKEN?.trim()) {
	return new Response('Portfolio content is not configured in this environment.', { status: 503 });
}

let canonicalTag = '';
let filtered: PortfolioProjectSummary[] = [];

try {
	const portfolio = createGitBookPortfolioFromEnv(gitbookEnv);
	const [tags, projects] = await Promise.all([
		portfolio.getProjectTags(),
		portfolio.getProjectsByTag(tagSlug),
	]);

	canonicalTag =
		tags.find((tag) => normalizeProjectTagKey(tag) === tagSlug) ?? '';
	filtered = projects;
} catch (error) {
	console.error('GitBook tag discovery failed.', error);
	return new Response('Portfolio content is temporarily unavailable.', { status: 503 });
}

if (!canonicalTag) {
	return Astro.redirect('/work/', 302);
}

const tagLabel = formatProjectTagLabel(canonicalTag);
---

<MainLayout
	title={`${tagLabel} | Work | Tajinder Singh`}
	description={`Architecture case studies tagged ${tagLabel}, covering system context, design decisions, target architecture and validation.`}
	keywords={[tagLabel, 'Architecture Portfolio', 'Case Study', 'Solution Architect', 'Integration Architect']}
	width="full"
>
	<Container size="wide">
		<SectionHeading
			eyebrow="Architecture Portfolio"
			title={`Case studies: ${tagLabel}`}
			description="Architecture case studies connected to this domain, technology or material system concern."
		/>
		<p class="tag-back"><PillTag label="← Back to all work" href="/work/" /></p>
		<ul class="work-grid">
			{filtered.map((project) => (
				<li>
					<ProjectCard
						title={project.title}
						description={project.description}
						tags={project.tags.map(formatProjectTagLabel)}
						sectionCount={project.sectionCount}
						href={`/work/${project.slug}/`}
					/>
				</li>
			))}
		</ul>
	</Container>
</MainLayout>

<style>
	.tag-back {
		margin-bottom: 1.3rem;
	}

	.work-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	@media (max-width: 900px) {
		.work-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
