---
import { env } from 'cloudflare:workers';

import GitBookDocumentationReader from '../../../components/GitBookDocumentationReader.astro';
import { createGitBookPortfolioFromEnv } from '../../../lib/gitbook';
import type { GitBookRuntimeEnv } from '../../../lib/gitbook';

export const prerender = false;

const slug = Astro.params.slug?.trim().toLowerCase() ?? '';
const gitbookEnv = env as unknown as GitBookRuntimeEnv;

if (!gitbookEnv.GITBOOK_TOKEN?.trim()) {
	return new Response('GitBook preview is not configured in this environment.', { status: 503 });
}

const portfolio = createGitBookPortfolioFromEnv(gitbookEnv);
const project = await portfolio.getProject(slug);

if (!project) {
	return new Response('GitBook project not found.', { status: 404 });
}

const projectHref = `/work/cms-preview/${project.slug}/`;
const pageHref = (relativePath: string) =>
	`${projectHref}section/${relativePath
		.split('/')
		.filter(Boolean)
		.map((segment) => encodeURIComponent(segment))
		.join('/')}/`;
---

<GitBookDocumentationReader
	project={project}
	navigation={project.navigation}
	projectHref={projectHref}
	pageHref={pageHref}
	rootMarkdown={project.markdown}
	backHref="/work/"
	backLabel="All work"
/>
