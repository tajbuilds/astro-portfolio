---
const slug = Astro.params.slug?.trim().toLowerCase() ?? '';
const pagePath = Astro.params.page?.trim() ?? '';

if (!slug || !pagePath) {
	return Astro.redirect('/work/', 302);
}

const encodedPagePath = pagePath
	.split('/')
	.filter(Boolean)
	.map((segment) => encodeURIComponent(segment))
	.join('/');

return Astro.redirect(
	`/work/${encodeURIComponent(slug)}/${encodedPagePath}/`,
	302,
);
---
