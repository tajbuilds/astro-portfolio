---
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ArchitectureReasoning from '../components/ArchitectureReasoning.astro';

const responsibilities = [
  {
    title: 'Discovery & problem framing',
    copy: 'Clarifying business need, stakeholder concerns, existing constraints and the real system boundary before selecting technology.',
  },
  {
    title: 'Current & target architecture',
    copy: 'Making the baseline understandable, defining responsibility changes and communicating a target state through the minimum useful viewpoints.',
  },
  {
    title: 'Integration & information design',
    copy: 'Defining APIs, hand-offs, information ownership, transformation and trust boundaries between platforms and services.',
  },
  {
    title: 'Options & architecture decisions',
    copy: 'Comparing realistic approaches, exposing trade-offs and keeping major decisions traceable to drivers and constraints.',
  },
  {
    title: 'Transition & operational readiness',
    copy: 'Considering coexistence, sequencing, fallback, observability, support boundaries and the practical path from current to target state.',
  },
  {
    title: 'Validation & delivery guidance',
    copy: 'Using prototypes, testing, stakeholder review and production evidence to increase confidence before and after implementation.',
  },
];

const artefacts = [
  'System context and boundary views',
  'Current-state / target-state diagrams',
  'Integration and request flows',
  'Information and ownership flows',
  'Architecture decisions and trade-offs',
  'Non-functional requirements',
  'Transition and coexistence approaches',
  'Proof-of-concept and validation evidence',
];

const principles = [
  'Start with the problem and constraints, not the product.',
  'Make responsibilities and boundaries explicit.',
  'Prefer understandable, operable systems over unnecessary sophistication.',
  'Design for failure, transition and support — not only the happy path.',
  'Use technology detail when it explains an architectural decision.',
];
---

<MainLayout
  title="About | Tajinder Singh"
  description="About Tajinder Singh, a Solution and Integration Architect focused on architecture reasoning, system boundaries, integrations, information flows and operationally reliable platforms."
>
  <Container size="wide">
    <section class="about-hero">
      <div class="about-hero__copy" data-reveal="soft">
        <p class="about-hero__kicker">About · Solution &amp; Integration Architect</p>
        <h1>I work between the problem, the systems and the teams that have to make the solution real.</h1>
        <p class="about-hero__positioning">
          My role is to turn business and operational needs into architecture that is clear enough to discuss,
          challenge, implement and support.
        </p>
        <p class="about-hero__support">
          That means understanding current state, defining boundaries, comparing options, shaping integration and
          information flows, making trade-offs visible and guiding a practical path toward the target state.
        </p>
        <div class="about-hero__actions">
          <ButtonLink href="/work">Explore Case Studies</ButtonLink>
          <ButtonLink href="/contact" variant="secondary">Get in Touch</ButtonLink>
        </div>
      </div>

      <aside class="about-profile surface-card surface-card--feature" data-reveal="right">
        <img
          src="/images/tajinder-singh-portrait.jpg"
          alt="Portrait of Tajinder Singh"
          loading="lazy"
          width="300"
          height="300"
        />
        <div>
          <p class="about-profile__label">Architecture practice</p>
          <strong>Solution design · integration design · architecture communication · technical validation</strong>
        </div>
        <dl>
          <div>
            <dt>Primary lens</dt>
            <dd>Responsibilities, boundaries and traceable decisions</dd>
          </div>
          <div>
            <dt>Delivery style</dt>
            <dd>Architecture-led, hands-on where validation helps</dd>
          </div>
          <div>
            <dt>Current direction</dt>
            <dd>Deeper solution, integration and technical architecture</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section class="page-section">
      <ArchitectureReasoning
        eyebrow="How I Work"
        title="A repeatable architecture reasoning chain"
        description="Frameworks inform the discipline, but the public output stays practical: understand the concern, bound the problem, evaluate options, design the target, plan transition and validate the result."
      />
    </section>

    <section class="page-section">
      <SectionHeading
        eyebrow="Architectural Responsibility"
        title="What I contribute to the work"
        description="The emphasis is on architectural responsibility and communication rather than implementation volume."
      />
      <div class="responsibility-list">
        {responsibilities.map((item, index) => (
          <article data-reveal="soft">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section about-grid">
      <article class="about-panel surface-card surface-card--feature" data-reveal="soft">
        <SectionHeading
          eyebrow="Architecture Artefacts"
          title="Making the reasoning inspectable"
          description="The exact set varies by project; the goal is always to answer a stakeholder concern rather than create diagrams for their own sake."
        />
        <div class="artefact-grid">
          {artefacts.map((item) => <span>{item}</span>)}
        </div>
      </article>

      <article class="about-panel surface-card surface-card--soft" data-reveal="soft">
        <SectionHeading
          eyebrow="Principles"
          title="How I judge a design"
        />
        <ul class="principles-list">
          {principles.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>

    <section class="page-section development-panel" data-reveal="soft">
      <div>
        <p class="development-panel__eyebrow">Professional Development</p>
        <h2>Extending the architecture lens into AI and data systems.</h2>
      </div>
      <div>
        <p>
          I am completing a Level 7 AI and Data Science apprenticeship, developing deeper understanding of statistical
          modelling, model validation, feature engineering and the production considerations around analytical systems.
        </p>
        <p>
          I treat that as an extension of architecture practice: understanding the behaviour, constraints and operating
          model of AI/data capabilities well enough to place them responsibly within wider systems.
        </p>
      </div>
    </section>

    <section class="page-section about-cta surface-card surface-card--feature" data-reveal="soft">
      <div>
        <p class="about-cta__eyebrow">Explore the evidence</p>
        <h2>The case studies show the architecture decisions, not just the technologies used.</h2>
      </div>
      <div class="about-cta__actions">
        <ButtonLink href="/work">View Architecture Work</ButtonLink>
        <ButtonLink href="/contact" variant="secondary">Contact</ButtonLink>
      </div>
    </section>
  </Container>
</MainLayout>

<style>
  .page-section {
    margin-top: clamp(2.5rem, 5vw, 5rem);
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(18rem, 0.88fr);
    gap: clamp(1.2rem, 3vw, 2.5rem);
    align-items: center;
  }

  .about-hero__copy {
    display: grid;
    gap: var(--space-3);
    max-width: 43rem;
  }

  .about-hero__kicker,
  .about-profile__label,
  .development-panel__eyebrow,
  .about-cta__eyebrow {
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .about-hero h1 {
    margin: 0;
    max-width: 15ch;
    font-size: clamp(2rem, 1.45rem + 1.75vw, 3.2rem);
    line-height: 1.03;
  }

  .about-hero__positioning,
  .about-hero__support {
    margin: 0;
    max-width: 39rem;
  }

  .about-hero__positioning {
    font-size: var(--font-size-body-lg);
    color: var(--color-text);
  }

  .about-hero__support {
    font-size: var(--font-size-ui);
  }

  .about-hero__actions,
  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .about-profile {
    display: grid;
    gap: var(--space-3);
    padding: 1rem;
  }

  .about-profile img {
    width: 5.2rem;
    height: 5.2rem;
    object-fit: cover;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .about-profile strong {
    display: block;
    max-width: 27rem;
    line-height: 1.45;
    font-size: 0.95rem;
  }

  .about-profile dl {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .about-profile dl div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-3);
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .about-profile dt {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text);
  }

  .about-profile dd {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .responsibility-list {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .responsibility-list article {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .responsibility-list article > span {
    padding-top: 0.15rem;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-accent);
  }

  .responsibility-list h3 {
    margin: 0 0 0.35rem;
    font-size: 1.08rem;
  }

  .responsibility-list p {
    margin: 0;
    max-width: 54rem;
    font-size: var(--font-size-ui);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-4);
  }

  .about-panel {
    padding: 1.2rem;
  }

  .about-panel :global(.section-heading) {
    margin-bottom: var(--space-4);
  }

  .artefact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
  }

  .artefact-grid span {
    padding: 0.7rem 0.2rem;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .artefact-grid span:nth-child(even) {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
  }

  .principles-list {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: var(--space-3);
  }

  .development-panel {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-5);
    padding: 1.2rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .development-panel h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.35rem, 1.15rem + 0.7vw, 1.9rem);
  }

  .development-panel p:last-child {
    margin-bottom: 0;
  }

  .about-cta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: end;
    padding: clamp(1.2rem, 2vw, 1.7rem);
  }

  .about-cta h2 {
    margin: 0.35rem 0 0;
    max-width: 21ch;
    font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2.2rem);
  }

  @media (max-width: 960px) {
    .about-hero,
    .about-grid,
    .development-panel {
      grid-template-columns: 1fr;
    }

    .about-cta {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .about-hero h1 {
      max-width: none;
    }

    .about-profile dl div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .responsibility-list article {
      grid-template-columns: 2.2rem minmax(0, 1fr);
      gap: var(--space-2);
    }

    .artefact-grid {
      grid-template-columns: 1fr;
    }

    .artefact-grid span:nth-child(even) {
      padding-left: 0.2rem;
      border-left: 0;
    }
  }
</style>
