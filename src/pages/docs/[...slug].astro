---
const slugParam = Astro.params.slug?.trim() ?? '';
const parts = slugParam.split('/').filter(Boolean);

if (parts.length < 2 || parts[0] !== 'case-studies') {
	return Astro.redirect('/work/', 301);
}

const projectSlug = encodeURIComponent(parts[1].toLowerCase());
const pagePath = parts
	.slice(2)
	.map((segment) => encodeURIComponent(segment))
	.join('/');

return Astro.redirect(
	pagePath
		? `/work/${projectSlug}/${pagePath}/`
		: `/work/${projectSlug}/`,
	301,
);
---
