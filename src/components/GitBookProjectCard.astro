---
interface Props {
  title: string;
  description: string;
  sectionCount: number;
  href: string;
}

const { title, description, sectionCount, href } = Astro.props;
const sectionLabel = `${sectionCount} architecture ${sectionCount === 1 ? 'section' : 'sections'}`;
---

<a class="cms-project-card-link" href={href} aria-label={`Preview GitBook case study: ${title}`}>
  <article class="cms-project-card surface-card surface-card--feature">
    <div class="cms-project-card__meta">
      <span>Architecture case study</span>
      <span aria-hidden="true">·</span>
      <span>{sectionLabel}</span>
    </div>

    <h3>{title}</h3>
    <p>{description}</p>

    <span class="cms-project-card__cta">
      Preview case study <span aria-hidden="true">-&gt;</span>
    </span>
  </article>
</a>

<style>
  .cms-project-card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .cms-project-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    height: 100%;
    padding: 1.25rem;
    overflow: hidden;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-base) var(--ease-standard),
      transform var(--motion-base) var(--ease-emphasis);
  }

  .cms-project-card:hover,
  .cms-project-card:focus-within {
    border-color: color-mix(in srgb, var(--color-accent) 46%, var(--color-border));
    box-shadow: var(--shadow-lg);
    transform: translateY(-5px);
  }

  .cms-project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cms-project-card h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .cms-project-card p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .cms-project-card__cta {
    align-self: end;
    font-size: var(--font-size-ui);
    font-weight: 700;
    color: var(--color-accent);
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard);
  }

  .cms-project-card-link:hover .cms-project-card__cta,
  .cms-project-card-link:focus-visible .cms-project-card__cta {
    color: var(--color-accent-strong);
    transform: translateX(4px);
  }

  .cms-project-card-link:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cms-project-card,
    .cms-project-card__cta {
      transition: none;
    }

    .cms-project-card:hover,
    .cms-project-card:focus-within,
    .cms-project-card-link:hover .cms-project-card__cta,
    .cms-project-card-link:focus-visible .cms-project-card__cta {
      transform: none;
    }
  }
</style>
