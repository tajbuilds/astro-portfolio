---
import { marked } from 'marked';

import MainLayout from '../layouts/MainLayout.astro';
import DocNavTree from './DocNavTree.astro';
import type { NavNode } from './DocNavTree.astro';
import type { PortfolioTagCategory } from '../lib/gitbook';

type Breadcrumb = {
	label: string;
	href: string;
};

type ReaderLink = {
	title: string;
	href: string;
};

type ProjectTag = {
	label: string;
	category: PortfolioTagCategory;
};

interface Props {
	title: string;
	description: string;
	projectTitle: string;
	currentTitle: string;
	currentSlugPath: string;
	navTree: NavNode[];
	toLink: (slugPath: string) => string;
	breadcrumbs: Breadcrumb[];
	summary: string;
	sectionCount: number;
	depthLabel: string;
	sourceLabel: string;
	projectTags?: ProjectTag[];
	markdown: string;
	previous?: ReaderLink | null;
	next?: ReaderLink | null;
	backHref: string;
	backLabel: string;
	kicker?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	projectTitle,
	currentTitle,
	currentSlugPath,
	navTree,
	toLink,
	breadcrumbs,
	summary,
	sectionCount,
	depthLabel,
	sourceLabel,
	projectTags = [],
	markdown,
	previous = null,
	next = null,
	backHref,
	backLabel,
	kicker = 'Extended Case Study',
	noindex = false,
} = Astro.props;

const bodyHtml = await marked.parse(markdown || '');
---

<MainLayout
	title={title}
	description={description}
	type="article"
	noindex={noindex}
	width="full"
	mainClass="docs-pg"
>
	<div class="docs-shell">
		<aside class="docs-sidebar surface-card surface-card--soft" data-reveal="left">
			<div class="docs-sidebar__inner">
				<a href={backHref} class="docs-back-link">
					<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path
							d="M10 3L5 8l5 5"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
					{backLabel}
				</a>

				<div class="docs-sidebar__section">
					<p class="docs-sidebar__eyebrow">Case Study</p>
					<strong class="docs-sidebar__title">{projectTitle}</strong>
				</div>

				<button
					class="docs-mobile-nav-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="docs-project-navigation"
					data-doc-nav-toggle
				>
					<span>Project sections</span>
					<span aria-hidden="true">+</span>
				</button>

				<div id="docs-project-navigation" class="docs-sidebar__nav" data-doc-nav>
					<nav aria-label="Case study navigation">
						<ul class="docs-nav-tree">
							<DocNavTree nodes={navTree} currentSlugPath={currentSlugPath} toLink={toLink} />
						</ul>
					</nav>
				</div>
			</div>
		</aside>

		<div class="docs-body">
			<article class="docs-article surface-card surface-card--standard" data-reveal="soft">
				{
					breadcrumbs.length > 1 && (
						<nav class="docs-breadcrumbs" aria-label="Breadcrumb">
							<ol>
								{breadcrumbs.map((crumb, index) => (
									<li>
										{index === breadcrumbs.length - 1 ? (
											<span aria-current="page">{crumb.label}</span>
										) : (
											<a href={crumb.href}>{crumb.label}</a>
										)}
									</li>
								))}
							</ol>
						</nav>
					)
				}

				<header class="docs-hero">
					<p class="docs-hero__kicker">{kicker}</p>
					<h1 class="docs-page-title">{currentTitle}</h1>
					<p class="docs-hero__summary">{summary}</p>
					<div class="docs-hero__meta" aria-label="Document metadata">
						<span>{sectionCount} architecture views</span>
						<span>{depthLabel}</span>
						<span>{sourceLabel}</span>
					</div>
					{
						projectTags.length > 0 && (
							<div class="docs-hero__tags" aria-label="Project architecture metadata">
								{projectTags.map((tag) => (
									<span class:list={['docs-hero__tag', `docs-hero__tag--${tag.category}`]}>
										<span class="sr-only">{tag.category}: </span>
										{tag.label}
									</span>
								))}
							</div>
						)
					}
				</header>

				<div class="docs-prose" data-doc-content>
					<Fragment set:html={bodyHtml} />
				</div>

				{
					(previous || next) && (
						<nav class="docs-pager" aria-label="Pagination">
							{previous ? (
								<a href={previous.href} class="docs-pager__item docs-pager__item--prev">
									<span class="docs-pager__dir">&#8592; Previous</span>
									<span class="docs-pager__label">{previous.title}</span>
								</a>
							) : (
								<span />
							)}
							{next ? (
								<a href={next.href} class="docs-pager__item docs-pager__item--next">
									<span class="docs-pager__dir">Next &#8594;</span>
									<span class="docs-pager__label">{next.title}</span>
								</a>
							) : (
								<span />
							)}
						</nav>
					)
				}
			</article>
		</div>

		<aside
			class="docs-toc surface-card surface-card--soft"
			aria-label="On this page"
			data-doc-rail
			data-reveal="right"
		>
			<p class="docs-toc__label">On this page</p>
			<ul class="docs-toc__list" data-doc-toc-list></ul>
		</aside>
	</div>

	<dialog id="docs-diagram-lightbox" class="docs-diagram-lightbox" aria-label="Expanded diagram view">
		<div class="docs-diagram-lightbox__panel" role="document">
			<div class="docs-diagram-lightbox__toolbar">
				<div class="docs-diagram-lightbox__hint">Scroll to zoom, drag to move</div>
				<div class="docs-diagram-lightbox__controls">
					<button type="button" data-zoom-out aria-label="Zoom out">-</button>
					<button type="button" data-zoom-reset aria-label="Reset zoom">Reset</button>
					<button type="button" data-zoom-in aria-label="Zoom in">+</button>
					<button type="button" data-close aria-label="Close viewer">Close</button>
				</div>
			</div>
			<div class="docs-diagram-lightbox__viewport" data-viewport>
				<img data-image alt="Expanded diagram" draggable="false" />
			</div>
		</div>
	</dialog>
</MainLayout>

<script type="module" src="/scripts/documentation-mermaid.js"></script>

<script is:inline>
(() => {
const sidebar = document.querySelector('.docs-sidebar');
const toggle = document.querySelector('[data-doc-nav-toggle]');
const nav = document.querySelector('[data-doc-nav]');
if (!(sidebar instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

const setOpen = (open) => {
sidebar.dataset.mobileOpen = open ? 'true' : 'false';
toggle.setAttribute('aria-expanded', String(open));
const indicator = toggle.querySelector('[aria-hidden="true"]');
if (indicator instanceof HTMLElement) indicator.textContent = open ? '−' : '+';
};

toggle.addEventListener('click', () => {
setOpen(toggle.getAttribute('aria-expanded') !== 'true');
});

if (window.matchMedia('(max-width: 860px)').matches) {
setOpen(false);
}
})();
</script>


<script is:inline>
(() => {
const content = document.querySelector('[data-doc-content]');
const tocList = document.querySelector('[data-doc-toc-list]');
const rail = document.querySelector('[data-doc-rail]');
if (
!(content instanceof HTMLElement) ||
!(tocList instanceof HTMLElement) ||
!(rail instanceof HTMLElement)
) return;

const slugCounts = new Map();
const slugify = (value) => {
const base = value.toLowerCase().trim()
.replace(/[^a-z0-9\s-]/g, '')
.replace(/\s+/g, '-')
.replace(/-+/g, '-') || 'section';
const seen = slugCounts.get(base) || 0;
slugCounts.set(base, seen + 1);
return seen === 0 ? base : `${base}-${seen}`;
};

const headings = Array.from(content.querySelectorAll('h2, h3'));
if (headings.length === 0) { rail.classList.add('is-empty'); return; }

const items = headings.map((heading) => {
if (!heading.id) heading.id = slugify(heading.textContent || 'section');
const li = document.createElement('li');
if (heading.tagName.toLowerCase() === 'h3') li.classList.add('is-sub');
const link = document.createElement('a');
link.href = '#' + heading.id;
link.textContent = (heading.textContent || '').trim();
li.appendChild(link);
tocList.appendChild(li);
return { heading, link };
});

if (!('IntersectionObserver' in window)) return;

const observer = new IntersectionObserver(
(entries) => {
const visible = entries
.filter((e) => e.isIntersecting)
.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
if (visible.length === 0) return;
const activeId = visible[0].target.id;
items.forEach(({ heading, link }) => {
if (heading.id === activeId) link.setAttribute('aria-current', 'true');
else link.removeAttribute('aria-current');
});
},
{ rootMargin: '-12% 0px -75% 0px', threshold: [0, 1] }
);

items.forEach(({ heading }) => observer.observe(heading));
})();
</script>

<script is:inline>
(() => {
const prose = document.querySelector('[data-doc-content]');
const dialog = document.getElementById('docs-diagram-lightbox');
if (!(prose instanceof HTMLElement) || !(dialog instanceof HTMLDialogElement)) return;

const img = dialog.querySelector('[data-image]');
const viewport = dialog.querySelector('[data-viewport]');
const closeBtn = dialog.querySelector('[data-close]');
const zoomInBtn = dialog.querySelector('[data-zoom-in]');
const zoomOutBtn = dialog.querySelector('[data-zoom-out]');
const zoomResetBtn = dialog.querySelector('[data-zoom-reset]');

if (!(img instanceof HTMLImageElement) || !(viewport instanceof HTMLElement)) return;

let scale = 1;
let tx = 0;
let ty = 0;
let dragging = false;
let lastX = 0;
let lastY = 0;

const MIN_SCALE = 1;
const MAX_SCALE = 6;
const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

const applyTransform = () => {
img.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
};

const resetTransform = () => {
scale = 1;
tx = 0;
ty = 0;
applyTransform();
};

const setScale = (nextScale) => {
const clamped = clamp(nextScale, MIN_SCALE, MAX_SCALE);
if (clamped === MIN_SCALE) {
tx = 0;
ty = 0;
}
scale = clamped;
applyTransform();
};

const svgToDataUrl = (sourceSvg) => {
const clone = sourceSvg.cloneNode(true);
if (!(clone instanceof SVGElement)) return '';

clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
const serialized = new XMLSerializer().serializeToString(clone);

return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(serialized)}`;
};

const openLightbox = (sourceImg) => {
img.src = sourceImg.currentSrc || sourceImg.src;
img.alt = sourceImg.alt || 'Expanded diagram';
resetTransform();
if (typeof dialog.showModal === 'function') {
dialog.showModal();
} else {
dialog.setAttribute('open', '');
dialog.classList.add('is-open');
}
};

const openSvgLightbox = (sourceSvg) => {
const source = svgToDataUrl(sourceSvg);
if (!source) return;

img.src = source;
img.alt = sourceSvg.getAttribute('aria-label') || sourceSvg.getAttribute('aria-roledescription') || 'Expanded diagram';
resetTransform();
if (typeof dialog.showModal === 'function') {
dialog.showModal();
} else {
dialog.setAttribute('open', '');
dialog.classList.add('is-open');
}
};

const closeLightbox = () => {
if (dialog.open && typeof dialog.close === 'function') {
dialog.close();
return;
}
dialog.removeAttribute('open');
dialog.classList.remove('is-open');
img.src = '';
resetTransform();
};

const enhanceZoomTargets = () => {
prose.querySelectorAll('img').forEach((sourceImg) => {
sourceImg.classList.add('docs-zoomable-diagram');
sourceImg.setAttribute('tabindex', '0');
sourceImg.setAttribute('role', 'button');
sourceImg.setAttribute('aria-label', 'Open expanded diagram');
});

prose.querySelectorAll('.diagram-mermaid, .mermaid').forEach((diagram) => {
diagram.classList.add('docs-zoomable-mermaid');
diagram.setAttribute('tabindex', '0');
diagram.setAttribute('role', 'button');
diagram.setAttribute('aria-label', 'Open expanded diagram');
});
};

const openFromTarget = (target) => {
const sourceImg = target instanceof Element ? target.closest('img') : null;
if (sourceImg instanceof HTMLImageElement && prose.contains(sourceImg)) {
openLightbox(sourceImg);
return true;
}

const sourceDiagram = target instanceof Element ? target.closest('.diagram-mermaid, .mermaid') : null;
const sourceSvg = sourceDiagram?.querySelector('svg') || (target instanceof SVGElement ? target.closest('svg') : null);
if (sourceSvg instanceof SVGElement && sourceDiagram && prose.contains(sourceDiagram)) {
openSvgLightbox(sourceSvg);
return true;
}

return false;
};

enhanceZoomTargets();

prose.addEventListener('click', (event) => {
if (!openFromTarget(event.target)) return;

event.preventDefault();
event.stopPropagation();
});

prose.addEventListener('keydown', (event) => {
if (event.key === 'Enter' || event.key === ' ') {
if (!openFromTarget(event.target)) return;
event.preventDefault();
event.stopPropagation();
}
});

const observer = new MutationObserver(() => enhanceZoomTargets());
observer.observe(prose, { childList: true, subtree: true });

viewport.addEventListener('wheel', (event) => {
event.preventDefault();
const delta = event.deltaY < 0 ? 0.18 : -0.18;
setScale(scale + delta);
}, { passive: false });

viewport.addEventListener('pointerdown', (event) => {
if (scale <= 1) return;
dragging = true;
lastX = event.clientX;
lastY = event.clientY;
viewport.setPointerCapture(event.pointerId);
viewport.classList.add('is-dragging');
});

viewport.addEventListener('pointermove', (event) => {
if (!dragging) return;
const dx = event.clientX - lastX;
const dy = event.clientY - lastY;
lastX = event.clientX;
lastY = event.clientY;
tx += dx;
ty += dy;
applyTransform();
});

const stopDrag = (event) => {
if (!dragging) return;
dragging = false;
viewport.classList.remove('is-dragging');
if (event && viewport.hasPointerCapture(event.pointerId)) {
viewport.releasePointerCapture(event.pointerId);
}
};

viewport.addEventListener('pointerup', stopDrag);
viewport.addEventListener('pointercancel', stopDrag);
viewport.addEventListener('pointerleave', stopDrag);

zoomInBtn?.addEventListener('click', () => setScale(scale + 0.3));
zoomOutBtn?.addEventListener('click', () => setScale(scale - 0.3));
zoomResetBtn?.addEventListener('click', resetTransform);
closeBtn?.addEventListener('click', closeLightbox);

dialog.addEventListener('click', (event) => {
if (event.target === dialog) closeLightbox();
});

document.addEventListener('keydown', (event) => {
if (event.key === 'Escape' && dialog.open) closeLightbox();
});

dialog.addEventListener('close', () => {
img.src = '';
resetTransform();
});
})();
</script>



<style>
:global(.site-main.docs-pg) {
padding: 0;
max-width: none;
}

.docs-shell {
--docs-sticky-top: 4.9rem;
--docs-rail-label-size: var(--font-size-xs);
--docs-rail-link-size: 0.85rem;
--docs-rail-sub-size: 0.8rem;
--docs-rail-link-line: 1.45;
--docs-rail-link-padding-block: 0.36rem;
--docs-rail-link-padding-inline: 0.52rem;
--docs-rail-active-bg: color-mix(in srgb, var(--color-accent) 10%, transparent);
--docs-rail-hover-bg: color-mix(in srgb, var(--color-border) 48%, transparent);
--docs-rail-active-color: var(--color-accent);
--docs-rail-muted-color: var(--color-text-muted);
display: grid;
grid-template-columns: minmax(15rem, 18rem) minmax(0, 1fr) minmax(12rem, 15rem);
gap: clamp(1rem, 2vw, 1.5rem);
width: min(100% - 2rem, 96rem);
margin-inline: auto;
padding: clamp(1rem, 2vw, 1.75rem) 0 clamp(2.5rem, 4vw, 4rem);
min-height: calc(100vh - 4rem);
background:
radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 28%),
radial-gradient(circle at 92% 8%, color-mix(in srgb, var(--color-focus) 9%, transparent), transparent 30%);
}

/* LEFT SIDEBAR */
.docs-sidebar {
position: sticky;
top: var(--docs-sticky-top);
height: calc(100vh - var(--docs-sticky-top) - 1rem);
overflow-y: auto;
scrollbar-width: thin;
scrollbar-color: var(--color-border) transparent;
align-self: start;
}
.docs-sidebar__inner {
padding: 1rem;
}

.docs-mobile-nav-toggle {
display: none;
width: 100%;
align-items: center;
justify-content: space-between;
gap: 0.75rem;
margin: 0 0 0.65rem;
padding: 0.65rem 0.72rem;
border: 1px solid var(--color-border);
border-radius: var(--radius-sm);
background: color-mix(in srgb, var(--color-bg-elevated) 88%, var(--color-surface));
color: var(--color-text);
font: inherit;
font-size: var(--font-size-sm);
font-weight: 700;
text-align: left;
cursor: pointer;
}

.docs-mobile-nav-toggle:focus-visible {
outline: 3px solid color-mix(in srgb, var(--color-accent) 28%, transparent);
outline-offset: 2px;
}
.docs-back-link {
display: inline-flex;
align-items: center;
gap: 0.3rem;
font-size: 0.8rem;
color: var(--color-text-muted);
text-decoration: none;
margin-bottom: 1.4rem;
transition: color var(--motion-fast) var(--ease-standard);
}
.docs-back-link:hover { color: var(--color-accent); }
.docs-sidebar__section { margin-bottom: 0.85rem; }
.docs-sidebar__eyebrow {
margin: 0 0 0.15rem;
font-size: var(--docs-rail-label-size);
text-transform: uppercase;
letter-spacing: 0;
color: var(--docs-rail-muted-color);
font-weight: 700;
}
.docs-sidebar__title {
display: block;
font-size: 0.925rem;
line-height: 1.35;
color: var(--color-text);
}

/* Nav tree — :global because DocNavTree renders its own elements */
:global(.docs-nav-tree),
:global(.docs-nav-tree .nav-sub) {
list-style: none;
padding: 0;
margin: 0;
}
:global(.docs-nav-tree .nav-sub) {
margin: 0.1rem 0 0.25rem 0.65rem;
padding-left: 0.65rem;
border-left: 1px solid var(--color-border);
}
:global(.docs-nav-tree li) { display: grid; }
:global(.docs-nav-tree a) {
display: block;
padding: var(--docs-rail-link-padding-block) var(--docs-rail-link-padding-inline);
border-radius: var(--radius-sm);
font-size: var(--docs-rail-link-size);
line-height: var(--docs-rail-link-line);
text-decoration: none;
color: var(--docs-rail-muted-color);
transition: color var(--motion-fast) var(--ease-standard), background var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
}
:global(.docs-nav-tree .nav-sub a) {
font-size: var(--docs-rail-sub-size);
}
:global(.docs-nav-tree a:hover) {
color: var(--color-text);
background: var(--docs-rail-hover-bg);
transform: translateX(2px);
}
:global(.docs-nav-tree a[aria-current='page']) {
color: var(--docs-rail-active-color);
background: var(--docs-rail-active-bg);
font-weight: 700;
}
:global(.docs-nav-tree li.is-ancestor > a) { color: var(--color-text); }

/* CONTENT */
.docs-body { min-width: 0; overflow: hidden; }
.docs-article {
margin: 0 auto;
padding: clamp(1.1rem, 2.5vw, 2rem);
max-width: 72ch;
min-width: 0;
box-shadow: var(--shadow-md);
}

/* Breadcrumbs */
.docs-breadcrumbs ol {
list-style: none;
padding: 0;
margin: 0 0 1.1rem;
display: flex;
flex-wrap: wrap;
font-size: 0.8rem;
color: var(--color-text-muted);
}
.docs-breadcrumbs li { display: inline-flex; align-items: center; }
.docs-breadcrumbs li:not(:last-child)::after { content: '/'; margin: 0 0.35rem; opacity: 0.4; }
.docs-breadcrumbs a { color: var(--color-text-muted); text-decoration: none; transition: color 0.12s; }
.docs-breadcrumbs a:hover { color: var(--color-accent); }
.docs-breadcrumbs span[aria-current='page'] { color: var(--color-text-muted); }

.docs-hero {
position: relative;
margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
padding: clamp(1.15rem, 2.2vw, 1.8rem);
border: 1px solid color-mix(in srgb, var(--color-accent) 20%, var(--color-border));
border-radius: var(--radius-md);
background:
linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 44%),
color-mix(in srgb, var(--color-bg-elevated) 86%, var(--color-surface));
overflow: hidden;
}

.docs-hero::after {
content: "";
position: absolute;
inset-block-start: -4rem;
inset-inline-end: -3rem;
width: 12rem;
height: 12rem;
border-radius: 999px;
background: color-mix(in srgb, var(--color-focus) 12%, transparent);
pointer-events: none;
}

.docs-hero__kicker {
position: relative;
z-index: 1;
margin: 0 0 0.45rem;
font-size: var(--font-size-xs);
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0;
color: var(--color-accent);
}

/* Page title */
.docs-page-title {
position: relative;
z-index: 1;
margin: 0;
font-size: clamp(1.75rem, 1.25rem + 1.5vw, 2.4rem);
line-height: 1.18;
letter-spacing: 0;
padding-bottom: 0;
border-bottom: 0;
}

.docs-hero__summary {
position: relative;
z-index: 1;
max-width: 66ch;
margin: 0.9rem 0 0;
font-size: var(--font-size-ui);
line-height: 1.65;
color: var(--color-text-muted);
}

.docs-hero__meta {
position: relative;
z-index: 1;
display: flex;
flex-wrap: wrap;
gap: 0.55rem;
margin-top: 1.05rem;
}

.docs-hero__meta span {
display: inline-flex;
align-items: center;
min-height: 1.85rem;
padding: 0.26rem 0.58rem;
border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
border-radius: 999px;
background: color-mix(in srgb, var(--color-bg-elevated) 80%, transparent);
color: var(--color-text-muted);
font-size: var(--font-size-xs);
font-weight: 700;
}

.docs-hero__tags {
position: relative;
z-index: 1;
display: flex;
flex-wrap: wrap;
gap: 0.4rem;
margin-top: 0.7rem;
}

.docs-hero__tag {
display: inline-flex;
align-items: center;
min-height: 1.7rem;
padding: 0.2rem 0.52rem;
border: 1px solid var(--color-border);
border-radius: 999px;
font-size: 0.72rem;
font-weight: 700;
color: color-mix(in srgb, var(--color-text-muted) 80%, var(--color-text));
background: color-mix(in srgb, var(--color-surface) 72%, transparent);
}

