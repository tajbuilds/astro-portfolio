---
import type { PortfolioTagCategory } from '../lib/gitbook';

interface Props {
	label: string;
	href?: string;
	category?: PortfolioTagCategory;
}

const { label, href, category } = Astro.props;
const classes = ['pill', category && `pill--${category}`];
---

{
	href ? (
		<a class:list={classes} href={href}>{label}</a>
	) : (
		<span class:list={classes}>{label}</span>
	)
}

<style>
	.pill {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.22rem 0.62rem;
		font-size: var(--font-size-xs);
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
		background: color-mix(in srgb, var(--color-accent) 11%, var(--color-bg-elevated));
		color: var(--color-text-muted);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
		transition:
			border-color var(--motion-fast) var(--ease-standard),
			background-color var(--motion-base) var(--ease-standard),
			transform var(--motion-fast) var(--ease-standard),
			box-shadow var(--motion-base) var(--ease-standard);
	}

	.pill--architecture {
		border-color: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
		background: color-mix(in srgb, var(--color-accent) 14%, var(--color-bg-elevated));
		color: var(--color-text);
	}

	.pill--technology {
		border-color: color-mix(in srgb, var(--color-focus) 32%, var(--color-border));
		background: color-mix(in srgb, var(--color-focus) 9%, var(--color-bg-elevated));
	}

	.pill--concern {
		border-style: dashed;
		background: color-mix(in srgb, var(--color-surface) 68%, var(--color-bg-elevated));
	}

	a.pill:hover {
		transform: translateY(-1px);
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 18%, var(--color-bg-elevated));
		color: var(--color-text);
		box-shadow: 0 10px 18px color-mix(in srgb, var(--color-accent) 14%, transparent);
	}
</style>
